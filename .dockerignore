# Что не должно попасть в образ.
#
# На хостинге код приходит из гита, поэтому лишнего там и так нет. Файл
# нужен для сборки с локальной машины: рядом лежат десятки мегабайт
# черновиков и — главное — секреты с базой.

# Секреты и данные. Даже случайно попасть в образ они не должны:
# образ можно выгрузить, а слои — прочитать.
server/.env
server/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Рабочие материалы: прошлые сборки, черновики, личные файлы
версии/
материалы/
документы/
*.mp4
*.zip

# Служебное
.git/
.github/
.claude/
node_modules/
*.log

# Секреты и данные в КОРНЕ проекта: рядом с server/.env лежит его копия
# (.env) и вторая база (data/). Без этих строк они уезжали в образ:
# образ можно выгрузить, а слои — прочитать.
.env
.env.*
!.env.example
data/
