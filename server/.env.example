# BloggerPay — настройки сервера-кассы.
# Скопируйте в .env и заполните. .env в репозиторий и в zip не кладут.

# Порт, на котором слушает сервер
PORT=8090

# Ключ оператора: открывает реестр выплат и сводку.
# Придумайте длинную случайную строку и никому не показывайте.
ADMIN_KEY=

# Откуда разрешено ходить браузеру (адрес сайта на Netlify).
# Звёздочка — только для локальной отладки.
ORIGIN=*

# Файл базы. Папка создастся сама.
DB_PATH=./data/bloggerpay.db

# Токен бота из BotFather. Пока пусто — вход по Телеграму отключён,
# приложение работает по email и паролю.
# Как получить: @BotFather → /newbot → токен вида 1234567890:AA...
# Этот же токен использует бот с кнопкой «Открыть» (node server/bot.js).
BOT_TOKEN=

# Адрес мини-аппа для кнопки бота — ТОЛЬКО https, иначе Телеграм её не
# покажет. Это адрес сайта с приложением (например, на Netlify),
# а не адрес этого сервера.
APP_URL=

# Адрес API Телеграма. Менять нужно только если с сервера не открывается
# api.telegram.org (в России это обычное дело) — тогда сюда ставится адрес
# вашего прокси. Пусто = обращаемся к Телеграму напрямую.
TG_API_BASE=

# Адрес, по которому сервер доступен снаружи. Нужен для возврата с площадок
# после подтверждения канала. Локально можно оставить как есть.
PUBLIC_URL=http://127.0.0.1:8090

# Подтверждение владения каналом. Человек входит в свой аккаунт на площадке,
# и она сама сообщает, чей это канал — подделать нельзя.
#
# YouTube: console.cloud.google.com → APIs & Services → Credentials →
#   OAuth client ID (тип «Web application»). В Authorized redirect URIs
#   добавить: <PUBLIC_URL>/api/verify/callback/youtube
#   Включить YouTube Data API v3, доступ youtube.readonly.
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# TikTok: developers.tiktok.com → своё приложение → Login Kit.
#   Redirect URI: <PUBLIC_URL>/api/verify/callback/tiktok
#   Доступы: user.info.basic, user.info.profile, user.info.stats
TT_CLIENT_KEY=
TT_CLIENT_SECRET=

# ── НАСТОЯЩИЙ ПРИЁМ ДЕНЕГ: ЮKassa ──────────────────────────────────
# Кабинет yookassa.ru → Интеграция → Ключи API. Нужен договор
# (ИП или юр. лицо). Как только оба ключа заполнены:
#   · пополнение в приложении идёт через страницу оплаты ЮKassa;
#   · тестовое пополнение выключается автоматически.
# В кабинете кассы укажите адрес вебхука (событие payment.succeeded):
#   <PUBLIC_URL>/api/pay/webhook
# Вебхук не обязателен: приложение само проверяет статус оплаты,
# но с вебхуком зачисление мгновенное.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Куда вернуть человека после оплаты: ссылка на ваш мини-апп,
# например https://t.me/<имя_бота>/<имя_аппа>
PAY_RETURN_URL=

# Тестовое пополнение БЕЗ кассы: 1 — включено (отладка), 0 — выключено.
# При заполненных ключах ЮKassa выключено всегда, что бы ни стояло тут.
TEST_TOPUP=1

# ОБЯЗАТЕЛЬНО НА БОЮ за обратным прокси (Caddy/nginx): 1 — брать адрес
# клиента из X-Forwarded-For. Без этого все запросы выглядят локальными
# и ограничение частоты (защита от перебора паролей) не работает.
TRUST_PROXY=

# ── Тревога в Телеграм ──────────────────────────────────────────
# Каждая новая ошибка сайта (и падение сервера, и расхождение денег)
# прилетает владельцу сообщением через бота. Нужны оба значения:
# BOT_TOKEN выше и числовой id чата владельца с ботом. Узнать свой id:
# написать @userinfobot. Владелец должен один раз нажать Start у бота,
# иначе Телеграм не даст боту писать первым.
ADMIN_CHAT_ID=

# ── Почта: восстановление пароля (Resend) ──────────────────────────
# Resend — отправка писем обычным HTTPS-запросом, без SMTP и без
# зависимостей. Кабинет: resend.com → API Keys → Create. Ключ (re_…)
# лежит только в .env, в приложение и репозиторий не попадает.
#
# Отправитель MAIL_FROM: для проверки годится onboarding@resend.dev, но
# такие письма приходят ТОЛЬКО на адрес владельца аккаунта Resend. Для боя
# подтвердите домен (Resend → Domains, записи SPF/DKIM) и укажите адрес на
# нём: MAIL_FROM=BloggerPay <no-reply@ваш-домен.ru>
#
# Поток: приложение шлёт POST /api/password/forgot {email} → на почту
# уходит код → POST /api/password/reset {email, code, password} задаёт
# новый пароль и сбрасывает все прежние входы.
RESEND_API_KEY=
MAIL_FROM=BloggerPay <onboarding@resend.dev>
MAIL_REPLY_TO=

# MAIL_DEBUG=1 — код восстановления возвращается прямо в ответе
# /api/password/forgot, чтобы проверять поток без настоящей почты.
# НА БОЮ ОБЯЗАТЕЛЬНО ПУСТО ИЛИ 0 — иначе код утекает в ответе.
MAIL_DEBUG=

# Знак BloggerPay в письме с кодом. Пусто — берётся APP_URL + /logo.jpg
# (файл logo.jpg уезжает на хостинг вместе с приложением). Вшить картинку
# в письмо нельзя: Gmail вырезает data:base64, будет пустой квадрат.
# Кнопка «Вернуться на сайт» в письме тоже ведёт на APP_URL — если он не
# заполнен, кнопки в письме просто не будет.
MAIL_LOGO_URL=

# Письмо БЕЗ кода (по умолчанию включено). Вместо цифр в письме кнопка
# «Открыть»; код показывается на странице <PUBLIC_URL>/r/<метка> после
# нажатия «Показать код». Зачем: код не виден в уведомлении на
# заблокированном экране и в списке писем, а почтовые сканеры (они
# открывают ссылки сами, GET-запросом) до него не добираются — показ
# идёт отдельным POST-запросом по нажатию.
# MAIL_LINK=0 — вернуть прежний вид, с кодом прямо в письме.
# Режим гаснет сам, если PUBLIC_URL не указан или без https://.
MAIL_LINK=1

# Почта владельца: этот аккаунт получает права админа в приложении сам,
# и раздел «Проверка документов» открывается без ввода ключа.
ADMIN_EMAIL=

# Права, которые просим у TikTok. Без пройденного ревью площадка выдаёт
# только user.info.basic — тогда оставьте здесь одно это значение, иначе
# вход упрётся в неодобренные права. Пусто — просим полный набор
# (basic + profile + stats), он нужен, чтобы знать число подписчиков.
TT_SCOPE=

# Адреса TikTok. Нужны, только если хостинг не пускает к площадке напрямую:
# сюда вписывают свой прокси. TT_API_BASE — куда ходит СЕРВЕР (обмен кода на
# данные аккаунта), TT_AUTH_BASE — куда отправляем человека.
# Пусто — работаем напрямую.
TT_API_BASE=
TT_AUTH_BASE=

# Уведомления на телефон: список ДОПОЛНИТЕЛЬНЫХ служб доставки через
# запятую. Нужен только для проверок (server/test-push-api.mjs).
# НА БОЮ ОСТАВЛЯТЬ ПУСТЫМ: с ним сервер соглашается слать уведомления
# на адрес, пришедший в теле запроса, — это путь наружу из вашей сети.
# Настоящие службы доставки уже перечислены в server/push.js.
PUSH_HOSTS_EXTRA=
